---
import Section from "@/components/ui/Section.astro";
import Container from "@/components/ui/Container.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import { solutions } from "@/data/solutions";
import {
	Briefcase,
	ClipboardList,
	Users,
	CalendarHeart,
	Award,
	Globe,
	FileText,
	BarChart3,
	ArrowRight,
} from "lucide-react";

// Rendered server-side to static HTML (no client directive, no JS shipped).
const ICONS: Record<string, typeof Briefcase> = {
	Briefcase,
	ClipboardList,
	Users,
	CalendarHeart,
	Award,
	Globe,
	FileText,
	BarChart3,
};

const COLOR: Record<string, string> = {
	blue: "bg-[var(--color-blue)]",
	green: "bg-[var(--color-green)]",
	pink: "bg-[var(--color-pink)]",
	purple: "bg-[var(--color-purple)]",
	orange: "bg-[var(--color-orange)]",
	yellow: "bg-[var(--color-yellow)]",
};

// Asymmetric grid: some cards span two columns for a neo-brutalist rhythm.
const SPAN: Record<number, string> = {
	0: "lg:col-span-2",
	3: "lg:col-span-2",
	4: "lg:col-span-2",
	7: "lg:col-span-2",
};
---

<Section>
	<Container class="flex flex-col gap-10">
		<div class="flex max-w-3xl flex-col gap-4">
			<SectionLabel>THE ECOSYSTEM</SectionLabel>
			<h2 class="font-[var(--font-heading)] text-3xl font-bold sm:text-4xl">
				One connected ecosystem for every student success programme.
			</h2>
			<p class="text-lg text-[var(--color-ink)]">
				Each module works on its own and shares the same data, so your teams stop
				re-entering information and start seeing the whole picture.
			</p>
		</div>

		<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
			{
				solutions.map((solution, index) => {
					const Icon = ICONS[solution.icon] ?? Briefcase;
					return (
						<a
							href={solution.href}
							class={`neo-card group flex h-full flex-col gap-4 no-underline ${SPAN[index] ?? ""}`}
						>
							<span
								class={`flex h-12 w-12 items-center justify-center rounded-[var(--radius)] border-2 border-[var(--color-ink)] ${COLOR[solution.color]}`}
							>
								<Icon size={24} strokeWidth={2.5} aria-hidden="true" />
							</span>
							<h3 class="font-[var(--font-heading)] text-xl font-bold">
								{solution.title}
							</h3>
							<p class="text-[var(--color-ink)]">{solution.description}</p>
							<ul class="flex flex-wrap gap-2">
								{solution.capabilities.slice(0, 3).map((cap) => (
									<li class="border-2 border-[var(--color-ink)] bg-[var(--color-paper)] px-2 py-0.5 text-xs font-semibold">
										{cap}
									</li>
								))}
							</ul>
							<span class="mt-auto inline-flex items-center gap-1 font-semibold underline">
								Learn more
								<ArrowRight size={16} aria-hidden="true" />
							</span>
						</a>
					);
				})
			}
		</div>
	</Container>
</Section>
