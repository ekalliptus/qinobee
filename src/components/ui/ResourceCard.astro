---
import Badge from "@/components/ui/Badge.astro";
import type { ResourceEntry } from "@/lib/content";
import { TYPE_LABEL, TYPE_TONE } from "@/lib/content";

interface Props {
  entry: ResourceEntry;
}

const { entry } = Astro.props;
const { data } = entry;
const dateLabel = data.publishedAt.toLocaleDateString("en-GB", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<a
  href={`/resources/${entry.id}`}
  class="neo-card group flex h-full flex-col gap-3 no-underline"
>
  <div class="flex items-center gap-3">
    <Badge tone={TYPE_TONE[data.type] as any}>{TYPE_LABEL[data.type]}</Badge>
    <time datetime={data.publishedAt.toISOString()} class="text-xs font-mono">
      {dateLabel}
    </time>
  </div>
  <h2 class="font-[var(--font-heading)] text-xl font-bold group-hover:underline">
    {data.title}
  </h2>
  <p class="text-[var(--color-ink)]">{data.description}</p>
</a>
