---
type Status = "empty" | "incomplete" | "complete" | "needs-improvement";

interface Props {
  status: Status;
  class?: string;
}

const { status, class: className = "" } = Astro.props;

// Each status carries a distinct symbol + label so meaning is never color-only.
const MAP: Record<Status, { bg: string; symbol: string; label: string }> = {
  empty: { bg: "bg-[var(--color-muted)]", symbol: "○", label: "Empty" },
  incomplete: {
    bg: "bg-[var(--color-yellow)]",
    symbol: "◐",
    label: "Incomplete",
  },
  "needs-improvement": {
    bg: "bg-[var(--color-orange)]",
    symbol: "!",
    label: "Needs improvement",
  },
  complete: { bg: "bg-[var(--color-success)]", symbol: "✓", label: "Complete" },
};

const meta = MAP[status];
const cls = [
  "inline-flex items-center gap-1.5 border-2 border-[var(--color-ink)] rounded-[var(--radius-sm)] px-2 py-0.5 text-xs font-semibold text-[var(--color-ink)]",
  meta.bg,
  className,
]
  .join(" ")
  .trim();
---

<span class={cls}>
  <span aria-hidden="true" class="font-mono">{meta.symbol}</span>
  <span>{meta.label}</span>
</span>
