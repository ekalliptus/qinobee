---
import { siteConfig } from "@/config/site";
import { footerNav, legalNav } from "@/config/navigation";

const year = new Date().getFullYear();
---

<footer class="border-t-2 border-[var(--color-ink)] bg-[var(--color-paper)] text-[var(--color-ink)]">
	<div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
		<div class="grid gap-10 md:grid-cols-4">
			<!-- Brand block -->
			<div class="md:col-span-1">
				<a href="/" class="font-[var(--font-heading)] text-xl font-extrabold tracking-tight">
					{siteConfig.name}
				</a>
				<p class="mt-3 text-sm leading-relaxed">{siteConfig.description}</p>
				<a
					href={`mailto:${siteConfig.email}`}
					class="mt-4 inline-block text-sm font-semibold underline underline-offset-2 hover:opacity-80"
				>
					{siteConfig.email}
				</a>
				<!-- Locale switch placeholder (matches header style) -->
				<div class="mt-4 inline-flex items-center border-2 border-[var(--color-ink)] bg-[var(--color-white)] text-xs font-bold uppercase">
					<span class="px-2 py-1.5 bg-[var(--color-ink)] text-[var(--color-paper)]">EN</span>
					<span class="px-2 py-1.5 opacity-50">ID</span>
				</div>
			</div>

			<!-- Nav columns -->
			{
				footerNav.map((group) => (
					<div>
						<h2 class="font-mono text-xs font-bold uppercase tracking-[0.2em]">{group.label}</h2>
						<ul class="mt-3 space-y-2">
							{group.links.map((link) => (
								<li>
									<a
										href={link.href}
										class="inline-flex min-h-[32px] items-center text-sm font-medium hover:underline underline-offset-4"
										{...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<div class="mt-12 flex flex-col gap-4 border-t-2 border-[var(--color-ink)] pt-6 sm:flex-row sm:items-center sm:justify-between">
			<p class="text-sm font-semibold">&copy; {year} {siteConfig.name}</p>
			<ul class="flex flex-wrap items-center gap-4">
				{
					legalNav.map((link) => (
						<li>
							<a href={link.href} class="text-sm font-medium hover:underline underline-offset-4">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</footer>
