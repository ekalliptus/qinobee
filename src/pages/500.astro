---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import Section from "@/components/ui/Section.astro";
import Container from "@/components/ui/Container.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import Button from "@/components/ui/Button.astro";
---

<MarketingLayout
  meta={{
    title: "Something went wrong",
    description: "An unexpected error occurred on our side.",
    noindex: true,
  }}
>
  <Section>
    <Container class="flex max-w-2xl flex-col gap-6">
      <SectionLabel>ERROR 500</SectionLabel>
      <h1 class="font-[var(--font-heading)] text-5xl font-bold sm:text-6xl">
        Something went wrong on our side.
      </h1>
      <p class="text-lg text-[var(--color-ink)]">
        This one is on us. Please try again in a moment. If the problem
        continues, we would appreciate hearing about it.
      </p>
      <div class="flex flex-wrap gap-4">
        <Button href="/" variant="primary" size="lg">Back to home</Button>
        <Button href="/resources" variant="secondary" size="lg"
          >Read the resources</Button
        >
      </div>
    </Container>
  </Section>
</MarketingLayout>
