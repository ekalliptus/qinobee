---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import Section from "@/components/ui/Section.astro";
import Container from "@/components/ui/Container.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import Button from "@/components/ui/Button.astro";
---

<MarketingLayout
  meta={{
    title: "Page not found",
    description: "The page you were looking for could not be found.",
    noindex: true,
  }}
>
  <Section>
    <Container class="flex max-w-2xl flex-col gap-6">
      <SectionLabel>ERROR 404</SectionLabel>
      <h1 class="font-[var(--font-heading)] text-5xl font-bold sm:text-6xl">
        We can't find that page.
      </h1>
      <p class="text-lg text-[var(--color-ink)]">
        The link may be broken, or the page may have moved. Let's get you back
        on track.
      </p>
      <div class="flex flex-wrap gap-4">
        <Button href="/" variant="primary" size="lg">Back to home</Button>
        <Button href="/solutions" variant="secondary" size="lg"
          >Browse solutions</Button
        >
      </div>
    </Container>
  </Section>
</MarketingLayout>
