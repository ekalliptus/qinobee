---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import Section from "@/components/ui/Section.astro";
import Container from "@/components/ui/Container.astro";
import NeoCard from "@/components/ui/NeoCard.astro";
import Button from "@/components/ui/Button.astro";
import Alert from "@/components/ui/Alert.astro";
import { getSqlDb } from "@/lib/db/client";
import { AuthService } from "@/lib/auth/service";
import { rateLimit } from "@/lib/rate-limit";
import { SESSION_COOKIE, cookieOptions } from "@/lib/auth/cookies";

let error = "";
let emailValue = "";

if (Astro.locals.user) return Astro.redirect("/app/dashboard");

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  emailValue = String(form.get("email") ?? "");
  const password = String(form.get("password") ?? "");
  const confirm = String(form.get("confirm") ?? "");

  const ip = Astro.clientAddress || "unknown";
  const limit = await rateLimit(getSqlDb(), `register:${ip}`, 10, 600);

  if (!limit.allowed) {
    error = "Too many attempts. Please try again later.";
  } else if (password !== confirm) {
    error = "Passwords do not match.";
  } else {
    const auth = new AuthService(getSqlDb());
    try {
      await auth.register(emailValue, password);
      const sess = await auth.login(emailValue, password);
      Astro.cookies.set(
        SESSION_COOKIE,
        sess.token,
        cookieOptions(import.meta.env.PROD),
      );
      return Astro.redirect("/app/dashboard");
    } catch (e) {
      const msg = (e as Error).message;
      error = msg.includes("already registered")
        ? "An account with that email already exists."
        : "Please enter a valid email and a password of at least 8 characters.";
    }
  }
}
---

<MarketingLayout meta={{ title: "Create account", noindex: true }}>
  <Section>
    <Container>
      <div class="mx-auto max-w-md">
        <NeoCard>
          <h1 class="text-2xl font-bold text-[var(--color-ink)]">
            Create your account
          </h1>
          {
            error && (
              <div class="mt-4">
                <Alert tone="danger">{error}</Alert>
              </div>
            )
          }
          <form method="POST" class="mt-6 flex flex-col gap-4">
            <div class="flex flex-col gap-1">
              <label for="email" class="font-medium">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                value={emailValue}
                class="border-2 border-[var(--color-ink)] rounded-[var(--radius-sm)] px-3 py-2"
              />
            </div>
            <div class="flex flex-col gap-1">
              <label for="password" class="font-medium">Password</label>
              <input
                id="password"
                name="password"
                type="password"
                required
                minlength="8"
                autocomplete="new-password"
                aria-describedby="password-hint"
                class="border-2 border-[var(--color-ink)] rounded-[var(--radius-sm)] px-3 py-2"
              />
              <span id="password-hint" class="text-sm text-[var(--color-ink)]/70">
                At least 8 characters.
              </span>
            </div>
            <div class="flex flex-col gap-1">
              <label for="confirm" class="font-medium">Confirm password</label>
              <input
                id="confirm"
                name="confirm"
                type="password"
                required
                minlength="8"
                autocomplete="new-password"
                class="border-2 border-[var(--color-ink)] rounded-[var(--radius-sm)] px-3 py-2"
              />
            </div>
            <Button type="submit" variant="primary">Create account</Button>
          </form>
          <p class="mt-4 text-sm">
            Already have an account? <a href="/login" class="underline">Sign in</a>.
          </p>
        </NeoCard>
      </div>
    </Container>
  </Section>
</MarketingLayout>
