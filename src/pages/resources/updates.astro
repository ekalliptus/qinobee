---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import Section from "@/components/ui/Section.astro";
import Container from "@/components/ui/Container.astro";
import SectionLabel from "@/components/ui/SectionLabel.astro";
import Breadcrumb from "@/components/ui/Breadcrumb.astro";
import Alert from "@/components/ui/Alert.astro";
import ResourceCard from "@/components/ui/ResourceCard.astro";
import { getResourcesByType } from "@/lib/content";

const resources = await getResourcesByType("update");
---

<MarketingLayout
  meta={{
    title: "Product Updates",
    description:
      "What is new in Qinobee: release notes and product updates across the platform.",
    canonical: "/resources/updates",
  }}
>
  <Section>
    <Container class="flex flex-col gap-10">
      <Breadcrumb
        items={[
          { name: "Home", href: "/" },
          { name: "Resources", href: "/resources" },
          { name: "Updates" },
        ]}
      />
      <div class="flex max-w-3xl flex-col gap-4">
        <SectionLabel>UPDATES</SectionLabel>
        <h1 class="font-[var(--font-heading)] text-4xl font-bold sm:text-5xl">
          What is new across the platform.
        </h1>
      </div>

      {
        resources.length === 0 ? (
          <Alert tone="info" title="Nothing here yet">
            There are no product updates published right now. Please check back
            soon.
          </Alert>
        ) : (
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {resources.map((entry) => (
              <ResourceCard entry={entry} />
            ))}
          </div>
        )
      }
    </Container>
  </Section>
</MarketingLayout>
