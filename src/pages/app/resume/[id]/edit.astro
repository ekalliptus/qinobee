---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSqlDb } from "@lib/db/client";
import { createResumeService } from "@modules/resume/services/resume-service";
import ResumeEditor from "@modules/resume/components/ResumeEditor";
import type { ResumeDocument } from "@modules/resume/types";

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login?next=" + encodeURIComponent(Astro.url.pathname));
}

const service = createResumeService(getSqlDb(Astro.locals));
let doc: ResumeDocument;
try {
  doc = await service.getOrThrow(user.id, Astro.params.id!);
} catch {
  return new Response("Not found", { status: 404 });
}
---

<BaseLayout meta={{ title: `Edit — ${doc.title}`, noindex: true }}>
  <main id="main-content" class="mx-auto w-full max-w-[1600px] px-4 py-6">
    <ResumeEditor client:load initialDoc={doc} />
  </main>
</BaseLayout>
