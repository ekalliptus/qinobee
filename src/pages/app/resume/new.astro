---
import AppLayout from "@/layouts/AppLayout.astro";
import { getSqlDb } from "@lib/db/client";
import { createResumeService } from "@modules/resume/services/resume-service";
import { listTemplates } from "@modules/resume/templates/registry";
import CreateResumeFlow from "@modules/resume/components/CreateResumeFlow";

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect("/login?next=/app/resume/new");

const svc = createResumeService(getSqlDb(Astro.locals));
const resumes = await svc.list(user.id);
const templates = listTemplates();

// Format resumes for the client component
const resumeStubs = resumes.map((r) => ({ id: r.id, title: r.title }));
---

<AppLayout meta={{ title: "Create a new CV" }}>
  <div class="mx-auto max-w-5xl">
    <h1 class="mb-8 text-3xl font-extrabold text-[var(--color-ink)]">Create a new CV</h1>
    <CreateResumeFlow resumes={resumeStubs} templates={templates} client:load />
  </div>
</AppLayout>
